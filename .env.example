# =============================================================================
# The Lenny Growth Assistant — environment configuration
#
# Copy to `.env` and edit:  cp .env.example .env
#
# The defaults below are chosen so that `docker compose up` works on a clean
# machine with NO cloud API keys and NO edits. Everything marked OPTIONAL can
# stay untouched for the standard local demo.
#
# NEVER commit a real .env — it is gitignored.
# =============================================================================


# -----------------------------------------------------------------------------
# [REQUIRED] Model provider selection
#
# This is the model-config layer. Changing provider/model here is the ONLY
# supported way to switch models — no application code is ever edited.
# -----------------------------------------------------------------------------

# Active provider: "ollama" (local, default, no key needed) | "anthropic" (cloud)
LLM_PROVIDER=ollama

# Provider used automatically if the primary is unavailable (missing key, daemon
# down, timeout). Set to "none" to disable fallback and fail loudly instead.
LLM_FALLBACK_PROVIDER=none


# -----------------------------------------------------------------------------
# [REQUIRED] Ollama — the mandatory local demo path
# -----------------------------------------------------------------------------

# From inside Docker use the host gateway; running natively use localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Generation model. ~4.7GB, 7B class, strong instruction-following + refusal.
#   Alternatives: llama3.1:8b  (comparable)
#                 llama3.2:3b  (low-RAM fallback, weaker at abstention)
OLLAMA_MODEL=qwen2.5:7b-instruct

# Embedding model used for both ingestion and query. 768 dimensions.
# NOTE: changing this REQUIRES a full re-ingest — the vector column is
# dimension-typed. See README "Changing the embedding model".
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Seconds before a generation request is abandoned.
OLLAMA_TIMEOUT_SECONDS=120


# -----------------------------------------------------------------------------
# [OPTIONAL] Anthropic cloud path
#
# Leave ANTHROPIC_API_KEY empty for the fully-local demo. If LLM_PROVIDER is
# "anthropic" and this is empty, the app logs a warning and falls back to
# Ollama when LLM_FALLBACK_PROVIDER allows it (see /api/models for live status).
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_SECONDS=120

# Agent runtime for the cloud path:
#   "sdk"      -> Claude Agent SDK (requires the `claude` CLI in the image)
#   "messages" -> direct Anthropic Messages API tool-use loop
# See architecture.md "Agent SDK vs. direct transport" for the trade-off.
ANTHROPIC_AGENT_RUNTIME=sdk


# -----------------------------------------------------------------------------
# [REQUIRED] PostgreSQL (+ pgvector)
#
# Compose provides this automatically. Override only for Supabase/Railway/etc.
# -----------------------------------------------------------------------------

POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_dev_password_change_me
POSTGRES_DB=lenny
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full DSN. If set, it wins over the discrete vars above.
# DATABASE_URL=postgresql+asyncpg://lenny:lenny_dev_password_change_me@db:5432/lenny


# -----------------------------------------------------------------------------
# [REQUIRED] Knowledge base / ingestion
# -----------------------------------------------------------------------------

# Source of truth for transcripts. Cloned at ingest time — never vendored into
# this repo (see PRD assumption A5: third-party copyrighted material).
CORPUS_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git

# Pin to a commit SHA for reproducible ingests; "main" tracks the branch tip.
CORPUS_REPO_REF=main

# Where the clone lands inside the container.
CORPUS_LOCAL_PATH=/app/data/corpus

# Chunking. Chunks follow speaker-turn boundaries; these are soft targets.
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TURNS=1

# Cap episodes ingested — useful for a fast first run. 0 = all 303.
INGEST_EPISODE_LIMIT=0


# -----------------------------------------------------------------------------
# [REQUIRED] Retrieval & grounding thresholds
#
# These are the dials that trade recall against hallucination risk.
# -----------------------------------------------------------------------------

# Candidates pulled from each of vector + keyword search before fusion.
RETRIEVAL_CANDIDATES=40

# Evidence passages actually shown to the model. Higher = better recall, slower
# local generation: each passage adds ~300 tokens of prompt evaluation, which is
# what dominates time-to-first-token on a 7B. 6 is the measured balance.
RETRIEVAL_TOP_K=6

# Relevance floor (0..1). If the best result scores below this, the assistant
# returns "insufficient evidence" instead of answering.
#
# CALIBRATED, not guessed. With nomic-embed-text on the full 303-episode index,
# in-corpus questions score 0.605-0.824 and out-of-corpus 0.525-0.586, so 0.60
# sits in the gap. This scale is model-specific: changing OLLAMA_EMBED_MODEL
# invalidates it. Re-measure with `make calibrate`.
RETRIEVAL_MIN_SCORE=0.60

# Max episodes a single answer may draw from, to keep citations legible.
RETRIEVAL_MAX_EPISODES=5


# -----------------------------------------------------------------------------
# [OPTIONAL] Application
# -----------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# "json" for machine-parseable structured logs, "console" for human reading.
LOG_FORMAT=console

# Comma-separated origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Public base URL of the backend, used by the frontend build.
VITE_API_BASE_URL=http://localhost:8000
